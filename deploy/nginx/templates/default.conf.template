# 백엔드 앞단 리버스 프록시. nginx 이미지가 기동할 때 envsubst 를 돌려 도메인 이름을
# 채우고 /etc/nginx/conf.d/default.conf 로 옮겨 놓는다.
#
# 치환 대상은 compose 의 NGINX_ENVSUBST_FILTER 로 SERVER_NAME 하나만 남겨 두었다.
# 좁히지 않으면 $host, $scheme 같은 nginx 자체 변수까지 빈 문자열로 치환돼 설정이
# 조용히 망가진다.
#
# 프론트는 Vercel 이 서빙한다. 여기서는 정적 파일을 다루지 않는다 — API 만 넘긴다.

# 컨테이너 이름이 곧 호스트명이다. IP 를 박으면 컨테이너를 다시 만들 때마다 바뀐다.
upstream cen_edu_backend {
    server backend:8080;
}

# 인증서를 아직 발급받지 못했어도 nginx 가 떠야 한다. 그래야 certbot 이
# /.well-known/acme-challenge 로 소유 확인을 할 수 있다. 80 번은 항상 연다.
server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt 소유 확인 경로. 인증서 발급과 갱신 모두 이 경로를 쓴다.
    # 리다이렉트보다 먼저 두어야 한다 — 443 으로 넘기면 확인이 실패한다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 필기 이미지 업로드가 기본값 1m 을 넘는다.
    client_max_body_size 10m;

    # 브라우저가 이 도메인을 항상 HTTPS 로만 부르게 한다. 인증서가 정상 발급된 뒤에
    # 켜는 것이 안전하다 — 잘못 켜면 되돌리는 데 max-age 만큼 걸린다.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        proxy_pass http://cen_edu_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # 백엔드가 원래 요청이 HTTPS 였음을 알아야 리다이렉트·쿠키가 어긋나지 않는다.
        proxy_set_header X-Forwarded-Proto $scheme;

        # 채점·분석은 접수 후 폴링 구조라 개별 요청은 짧다. 그래도 PDF 렌더링처럼
        # 한 번에 오래 붙잡는 경로가 있어 기본값 60s 보다 넉넉히 둔다.
        proxy_connect_timeout 10s;
        proxy_send_timeout   300s;
        proxy_read_timeout   300s;
    }

    # 헬스체크. 배포 스크립트와 감시 도구가 부른다.
    location = /actuator/health {
        proxy_pass http://cen_edu_backend;
        proxy_set_header Host $host;
        access_log off;
    }

    # API 문서는 외부에 열지 않는다. 필요하면 SSH 터널로 8080 에 직접 붙는다.
    location ~ ^/(swagger-ui|v3/api-docs) {
        deny all;
    }

    # 그 밖의 경로로 오는 요청은 받지 않는다. 프론트는 Vercel 에 있다.
    location / {
        return 404;
    }
}
