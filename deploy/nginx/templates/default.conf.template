# 서비스의 유일한 입구. TLS 를 여기서 끊고 뒤의 컨테이너로 넘긴다.
#
# nginx 이미지가 기동할 때 envsubst 를 돌려 도메인 이름을 채우고
# /etc/nginx/conf.d/default.conf 로 옮겨 놓는다.
#
# 치환 대상은 compose 의 NGINX_ENVSUBST_FILTER 로 SERVER_NAME 하나만 남겨 두었다.
# 좁히지 않으면 $host, $scheme 같은 nginx 자체 변수까지 빈 문자열로 치환돼 설정이
# 조용히 망가진다.
#
# 80 과 443 이 같은 경로를 서빙한다. HTTPS 로 강제 리다이렉트하지 않는다 —
# CloudFront 가 이 서버를 HTTP 로 부르고 있어, 301 을 돌려주면 그 경로가 끊긴다.

# 컨테이너 이름이 곧 호스트명이다. IP 를 박으면 컨테이너를 다시 만들 때마다 바뀐다.
upstream cen_edu_backend {
    server backend:8080;
}

upstream cen_edu_frontend {
    server frontend:80;
}

server {
    # 이 포트의 유일한 서버라 Host 가 무엇이든 여기로 온다. IP 직접 접속,
    # CloudFront, 그리고 인증서 발급 확인이 모두 이 블록을 지난다.
    listen 80 default_server;
    server_name _;

    # Let's Encrypt 소유 확인 경로. 발급과 갱신 모두 이 경로를 쓴다.
    # 인증서가 없어도 80 은 떠 있어야 하므로 이 블록은 TLS 와 무관하게 둔다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/snippets/app.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS 는 켜지 않는다. 켜면 브라우저가 이 호스트를 max-age 동안 HTTPS 로만
    # 부르게 되어, HTTP 경로를 함께 열어 둔 지금 구성과 어긋난다.

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/snippets/app.conf;
}
