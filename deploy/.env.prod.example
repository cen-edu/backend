# EC2 의 ~/app/.env 로 복사해 값을 채운다. compose 가 같은 디렉터리의 .env 를
# 자동으로 읽어 ${...} 를 치환하고, backend 컨테이너에는 env_file 로 그대로 들어간다.
#
#   scp -i cen-edu.pem deploy/.env.prod.example ec2-user@<EIP>:/home/ec2-user/app/.env
#   chmod 600 ~/app/.env
#
# 이 파일에 실제 값을 채워 커밋하지 않는다. 저장소에는 예시만 남긴다.

# --- 이미지 ---
# Docker Hub 계정과 배포할 태그. latest 를 쓰지 않는다 — 무엇이 돌고 있는지 구분되지 않고
# 되돌릴 이전 태그도 남지 않는다.
DOCKERHUB_USER=
APP_TAG=1.0.0
FRONTEND_TAG=1.0.0

# --- DB (컨테이너 postgres) ---
DB_NAME=cen_edu
DB_USERNAME=cen
# 로컬 compose 의 비밀번호를 그대로 쓰지 않는다. 최소 24자 랜덤:
#   openssl rand -base64 24
DB_PASSWORD=
# DB_URL 은 compose 가 postgres 서비스 이름으로 채운다. 여기서 지정하지 않는다.

# --- 인증 ---
# 최소 32바이트 랜덤. 값이 바뀌면 발급된 토큰이 전부 무효가 된다.
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1h

# --- CORS ---
# 반드시 채운다. 오리진이 하나여도 비워 두면 안 된다.
#
# 브라우저는 같은 오리진이라도 POST/PUT/DELETE 에는 Origin 헤더를 붙인다. 스프링의 CORS
# 필터가 그 헤더를 허용 목록과 대조하는데, 목록이 비어 있으면 403 "Invalid CORS request"
# 로 막는다. GET(화면·정적 파일)은 Origin 이 없어 통과하므로, 화면은 멀쩡한데 로그인과
# 회원가입만 실패하는 형태로 드러난다.
#
# 접속에 쓰는 주소를 전부 적는다. CloudFront 를 붙였다면 그 도메인과 EC2 주소 둘 다.
CORS_ALLOWED_ORIGINS=https://<배포도메인>.cloudfront.net,http://<EIP-또는-퍼블릭-IP>

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AWS S3 (문항·답안 이미지) ---
S3_ENABLED=true
AWS_REGION=ap-northeast-2
AWS_S3_PROBLEM_BUCKET=
AWS_S3_ANSWER_BUCKET=
# S3_ENABLED=true 면 두 값이 반드시 있어야 한다(S3Properties 의 @NotBlank). 비우면 기동이
# 깨진다. 두 버킷에만 권한을 준 전용 IAM 사용자의 키를 쓴다 — 루트 계정 키를 쓰지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 기능 토글 ---
PROBLEM_RAG_ENABLED=false
PROBLEM_RAG_INDEXING_ENABLED=false
PROBLEM_SEMANTIC_AUTHORING_ENABLED=false
