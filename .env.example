# 이 파일을 .env 로 복사한 뒤 값을 채우면 애플리케이션이 자동으로 읽는다.
#
#   PowerShell:  Copy-Item .env.example .env
#
# application.yaml 의 spring.config.import 설정이 프로젝트 루트의 .env 를 읽는다.
# 파일이 없어도 앱은 기본값으로 정상 기동한다. 실제 OS 환경 변수를 지정하면
# 그쪽이 .env 보다 우선한다.
#
# 작성 규칙 (properties 포맷)
#   - 값에 따옴표를 쓰지 않는다. KEY="abc" 는 따옴표까지 값에 포함된다.
#   - 백슬래시는 이스케이프 문자다. Windows 경로는 C:\\path\\to 처럼 두 번 쓴다.
#
# .env 는 .gitignore 에 등록돼 있다. 실제 키를 커밋하지 않는다.

# --- OpenAI (AI 연동 시) ---
OPENAI_API_KEY=

# --- JWT (인증 구현 시) : 최소 32바이트 랜덤 문자열 ---
JWT_SECRET=

# --- DB : 기본값과 다를 때만 지정 ---
DB_URL=jdbc:postgresql://localhost:5432/cen_edu
DB_USERNAME=cen
DB_PASSWORD=cen_local_password

SERVER_PORT=8080
