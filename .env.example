# 이 파일을 .env 로 복사한 뒤 값을 채우면 애플리케이션이 자동으로 읽는다.
#
#   PowerShell:  Copy-Item .env.example .env
#
# application.yaml 의 spring.config.import 설정이 프로젝트 루트의 .env 를 읽는다.
# 파일이 없어도 앱은 기본값으로 정상 기동한다. 실제 OS 환경 변수를 지정하면
# 그쪽이 .env 보다 우선한다.
#
# 작성 규칙 (properties 포맷)
#   - 값에 따옴표를 쓰지 않는다. KEY="abc" 는 따옴표까지 값에 포함된다.
#   - 백슬래시는 이스케이프 문자다. Windows 경로는 C:\\path\\to 처럼 두 번 쓴다.
#
# .env 는 .gitignore 에 등록돼 있다. 실제 키를 커밋하지 않는다.

# --- OpenAI (AI 연동 시) ---
# 키가 비어 있어도 앱은 기동한다. 다만 챗봇을 쓰면 그때 호출이 실패한다.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 아래 값은 application.yaml 에 기본값이 있다. 바꿀 때만 주석을 푼다.
# 빈 값으로 두면 기본값이 아니라 빈 문자열이 들어가 기동이 깨진다.
#OPENAI_MODEL=gpt-5-mini
#OPENAI_REASONING_EFFORT=minimal
#OPENAI_MAX_COMPLETION_TOKENS=3000
#OPENAI_TIMEOUT=60s
#OPENAI_MAX_RETRIES=2

# 문제 검증용 모델. 저작측과 다른 모델이어야 한다 — 같은 모델은 같은 방식으로 틀리고,
# 둘 다 틀려도 대조가 통과해 검증이 무력해진다.
#OPENAI_VERIFICATION_MODEL=gpt-5
#OPENAI_VERIFICATION_REASONING_EFFORT=medium
#OPENAI_VERIFICATION_MAX_COMPLETION_TOKENS=6000

# 학생 분석 문장 생성용 모델. 모델은 기본값과 같고 응답 상한만 다르다 — 문항마다
# 문장 세 개를 한 번에 받아 25문항 근처에서 기본 상한 3000 에 닿는다.
#OPENAI_ANALYSIS_REPORT_MODEL=gpt-5-mini
#OPENAI_ANALYSIS_REPORT_REASONING_EFFORT=minimal
#OPENAI_ANALYSIS_REPORT_MAX_COMPLETION_TOKENS=8000

# 원본 검사(해설 정합·개념 안내 누출) 토글. 끄면 문항당 LLM 호출이 절반이 된다.
#AI_VERIFICATION_CONTENT_CHECK_ENABLED=true

# --- JWT (인증 구현 시) : 최소 32바이트 랜덤 문자열 ---
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1h

# --- DB : 기본값과 다를 때만 지정 ---
DB_URL=jdbc:postgresql://localhost:5432/cen_edu
DB_USERNAME=cen
DB_PASSWORD=cen_local_password

SERVER_PORT=8080

# --- Problem RAG ---
PROBLEM_RAG_ENABLED=false
PROBLEM_RAG_INDEXING_ENABLED=false

# --- AWS S3 : 이미지 저장 기능을 사용할 때 true ---
S3_ENABLED=false
AWS_REGION=ap-northeast-2
AWS_S3_PROBLEM_BUCKET=
AWS_S3_ANSWER_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# presigned 조회 URL 만료 시간. 화면에 머무는 시간보다 짧으면 S3가 403을 준다.
AWS_S3_ANSWER_URL_EXPIRATION=2h
AWS_S3_PROBLEM_URL_EXPIRATION=6h

# 서술형 채점이 모델에 넘기는 답안 이미지 URL 의 만료. 기본값은 local 2h / 그 외 15m 이다.
# 칸마다 채점 직전에 발급하므로 배치 전체 소요와는 무관하다. 길게 둘수록 그 URL 을 가진
# 누구나 학생 필기를 볼 수 있는 시간이 늘어난다.
#AWS_S3_GRADING_PIPELINE_URL_EXPIRATION=15m

# --- AI : 입력 토큰 관련 설정 (기본 500. 빈 값으로 두면 기동이 깨진다) --
#AI_INPUT_MAX_LENGTH=500
